// Release.xcconfig -- base configuration for Release builds of the app, CLI,
// and MCP server.
//
// The production profile is intended for Developer ID signing and notarization.
// The v0.1.0-beta.1 public beta uses an explicit xcodebuild override for ad-hoc
// signing instead; it is not Developer ID signed or notarized. Keep the identity
// set in both positions so production settings cannot drift across SDKs.

#include "Signing.xcconfig"
#include "Version.xcconfig"

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Developer ID Application
CODE_SIGN_IDENTITY[sdk=macosx*] = Developer ID Application
PROVISIONING_PROFILE_SPECIFIER =
